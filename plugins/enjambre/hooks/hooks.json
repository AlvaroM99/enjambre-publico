{
  "description": "Hooks de Enjambre: protegen secretos, bloquean comandos reservados a Álvaro, limitan Bash en los agentes que no escriben código y registran la actividad de los agentes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/proteger-secretos.mjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/bloquear-comandos.mjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/limitar-bash.mjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/registrar-actividad.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/registrar-actividad.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
