+// Busca un producto por nombre en D1.
+export async function buscar(env, nombre) {
+  const sql = "SELECT * FROM productos WHERE nombre = '" + nombre + "'";
+  const r = await env.DB.prepare(sql).all();
+  return r.results;
+}
