{
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "api.cloudflare.com",
        "*.workers.dev"
      ]
    }
  }
}
